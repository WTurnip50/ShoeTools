@page
@model ShoeTools.Website.Pages.Users.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Inicio de Sesión</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #4e73df, #1cc88a);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .login-container {
            background-color: #fff;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
        }
        h2 {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #4e73df;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Inicio de Sesión</h2>
        <form method="post">
            <div class="mb-3">
                <label asp-for="User.username" class="form-label"></label>
                <input asp-for="User.username" class="form-control" />
                <span asp-validation-for="User.username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="User.password" class="form-label"></label>
                <input asp-for="User.password" type="password" class="form-control" />
                <span asp-validation-for="User.password" class="text-danger"></span>
            </div>

            @if (Model.Errors.Count > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <ul>
                        @foreach (var error in Model.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <button type="submit" class="btn btn-primary w-100">Login</button>
            <a asp-page="./NewUser" class="btn btn-outline-primary w-100 mt-4">Sign in</a>
        </form>
    </div>
</body>
</html>
