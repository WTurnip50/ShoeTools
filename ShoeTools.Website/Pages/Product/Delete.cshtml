@page "{id:int}"
@model ShoeTools.Website.Pages.Product.DeleteModel

<div class="container-fluid">
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <h2>Delete Product</h2>
            <form method="post">
                <input type="hidden" asp-for="Product.Id"/>
                <div class="form-group">
                    <label asp-for="Product.Name"></label>
                    <input readonly asp-for="Product.Name" class="form-control" maxlength="45"/>
                    <span class="text-danger" asp-validation-for="Product.Name"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Product.Description"></label>
                    <input readonly asp-for="Product.Description" class="form-control" maxlength="100"/>
                    <span class="text-danger" asp-validation-for="Product.Description"></span>
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <button type="submit" class="btn btn-primary mr-3">Delete</button>
                        <a asp-page="./List" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-1"></div>
    </div>
</div>