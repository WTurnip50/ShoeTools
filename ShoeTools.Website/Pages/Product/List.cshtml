@page
@model ShoeTools.Website.Pages.Product.ListModel

<div class="container-fluid">
    <form method="get">
        <div class="row">
            <div class="col-md-8">
                <input type="search" name="Id" value="@Model.Id"
                       class="form-control" placeholder="Buscar por Id"/>
            </div>
            <div class="col-md-4">
                <button id="btnSearch" class="btn btn-primary mr-3">Search</button>
                <a asp-page=".\Edit" class="btn btn-success">Add new</a>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <table class="table">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th></th>
                </tr>
                @foreach (var product in @Model.Products)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>
                            <a asp-page="/Product/Edit" asp-route-id="@product.Id"
                               class="btn btn-primary" role="button">Edit</a>
                            <a asp-page="/ProductDetails/List" asp-route-id="@product.Id"
                               class="btn btn-primary" role="button">Edit stock</a>
                            <a asp-page="/Product/Delete" asp-route-id="@product.Id"
                               class="btn btn-danger" role="button">Delete</a>
                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="col-md-1"></div>
    </div>
</div>