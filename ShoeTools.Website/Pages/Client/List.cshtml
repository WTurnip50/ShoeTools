@page
@model ShoeTools.Website.Pages.Client.List

<div class="container-fluid">
    <form method="get">
        <div class="row">
            <div class="col-md-8">
                <input type="search" name="Id" value="@Model.Id"
                       class="form-control" placeholder="Buscar por Id"/>
            </div>
            <div class="col-md-4">
                <button id="btnSearch" class="btn btn-primary mr-3">Search</button>
                <a asp-page=".\Edit" class="btn btn-success">Add new</a>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <table class="table">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th></th>
                </tr>
                @foreach (var client in @Model.Clients)
                {
                    <tr>
                        <td>@client.Id</td>
                        <td>@client.Name</td>
                        <td>@client.PhoneNumber</td>
                        <td>@client.Email</td>
                        <td>
                            <a asp-page="/Client/Edit" asp-route-id="@client.Id"
                               class="btn btn-primary" role="button">Editar</a>
                            <a asp-page="/Client/Delete" asp-route-id="@client.Id"
                               class="btn btn-danger" role="button">Eliminar</a>
                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="col-md-1"></div>
    </div>
</div>