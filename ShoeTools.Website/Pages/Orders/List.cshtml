@page
@model ShoeTools.Website.Pages.Orders.List

<div class="container-fluid">
    <form method="get">
        <div class="row">
            <div class="col-md-8">
                <input type="search" name="Id" value="@Model.Id"
                       class="form-control" placeholder="Buscar por Id de orden"/>
            </div>
            <div class="col-md-4">
                <button id="btnSearch" class="btn btn-primary mr-3">Search</button>
                <a asp-page=".\Add" class="btn btn-success">Add new</a>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <table class="table">
                <tr>
                    <th>Id</th>
                    <th>IdClient</th>
                    <th>Total</th>
                    <th>Payment Method</th>
                    <th>Pay status</th>
                    <th></th>
                </tr>
                @foreach (var order in @Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.ClientId</td>
                        <td>@order.Total</td>
                        <td>@order.PaymentMethod</td>
                        <td>@order.PaymentStatus</td>
                        <td>
                            <a asp-page="/OrderDetails/List" asp-route-id="@order.Id"
                               class="btn btn-primary" role="button">See details</a>
                            
                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="col-md-1"></div>
    </div>
</div>