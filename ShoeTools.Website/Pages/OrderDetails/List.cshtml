@page "{id:int}"
@model ShoeTools.Website.Pages.OrderDetails.List

<div class="container-fluid">
    <form method="get">
        <div class="row">
            <div class="col-md-8">
                <input type="search" name="Id" value="@Model.Id"
                       class="form-control" placeholder="Buscar por Id de orden"/>
            </div>
            <div class="col-md-4">
                <a asp-page=".\SelectProduct"  asp-route-id="@Model.Id"  class="btn btn-success">Add new item</a>
                <button asp-page=".\Paymenth" id="btnSearch" asp-route-id="@Model.Id" class="btn btn-primary mr-3">Complete Order</button>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <table class="table">
                <tr>
                    <th>Id</th>
                    <th>IdOrder</th>
                    <th>ProductId</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th></th>
                </tr>
                @foreach (var order in @Model.DetailsDto)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderID </td>
                        <td>@order.ProductID</td>
                        <td>@order.UnitPrice</td>
                        <td>@order.Quantity</td>
                        <td>
                            <a asp-page="/OrderDetails/Update" asp-route-id="@order.Id"
                               class="btn btn-primary" role="button">Edit Product</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@order.Id" class="d-inline">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="col-md-1"></div>
    </div>
</div>