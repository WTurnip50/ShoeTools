@page
@model ShoeTools.Website.Pages.OrderDetails.Paymenth

@{
    Layout = null;
}

<html>
<head>
    <meta charset="utf-8"/>
    <title>Actualizar estado de pago</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"/>
    <style>
        body {
            background: linear-gradient(135deg, #4e73df, #1cc88a);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .card {
            width: 500px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }
        .btn-save {
            background-color: #1cc88a;
            color: white;
            font-weight: bold;
        }
        .btn-cancel {
            background-color: #e74a3b;
            color: white;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="card p-4">
    <h3 class="text-center mb-4">Pago a realizar</h3>
    <form method="post">
        <input type="hidden" asp-for="OrdersDto.Id" />
        <input type="hidden" asp-for="OrdersDto.PaymentMethod" />
        <!-- Id del Producto -->
        <div class="mb-3">
            <label asp-for="OrdersDto.ClientId" class="form-label">ID del Cliente</label>
            <input asp-for="OrdersDto.ClientId" class="form-control" readonly/>
        </div>
        
        <!-- Cantidad -->
        <div class="mb-3">
            <label asp-for="OrdersDto.OrderDate" class="form-label">Fecha de realizacion</label>
            <input asp-for="OrdersDto.OrderDate" class="form-control" type="datetime" readonly/>
        </div>
        
        <div class="mb-3">
            <label asp-for="OrdersDto.Total" class="form-label">Total de la venta</label>
            <input asp-for="OrdersDto.Total" class="form-control" type="number" readonly/>
        </div>

        <!-- Botones -->
        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-save w-45">
                <i class="bi bi-check-circle"></i> Save
            </button>
            <a asp-page="/Orders/List" class="btn btn-cancel w-45">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>
</body>
</html>