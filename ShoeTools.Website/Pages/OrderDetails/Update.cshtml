@page
@model ShoeTools.Website.Pages.OrderDetails.Update

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8"/>
    <title>Actualizar Orden</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"/>
    <style>
        body {
            background: linear-gradient(135deg, #4e73df, #1cc88a);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .card {
            width: 500px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }
        .btn-save {
            background-color: #1cc88a;
            color: white;
            font-weight: bold;
        }
        .btn-cancel {
            background-color: #e74a3b;
            color: white;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="card p-4">
    <h3 class="text-center mb-4">Datos a actualizar</h3>
    <form method="post">
        <input type="hidden" asp-for="OrderDetailsDto.Id" />
        <!-- Id de la Orden -->
        <div class="mb-3">
            <label asp-for="OrderDetailsDto.OrderID" class="form-label">ID de la Orden</label>
            <input asp-for="OrderDetailsDto.OrderID" class="form-control" readonly/>
        </div>

        <!-- Id del Producto -->
        <div class="mb-3">
            <label asp-for="OrderDetailsDto.ProductID" class="form-label">ID del Producto</label>
            <input asp-for="OrderDetailsDto.ProductID" class="form-control" readonly/>
        </div>

        <!-- Lista desplegable de tallas -->
        <div class="mb-3">
            <label asp-for="idSize" class="form-label">Talla</label>
            <select asp-for="idSize" class="form-select" asp-items="@(new SelectList(Model.ProductDetailsDtosList, "Id", "Size"))">
                <option value="">-- Selecciona una talla --</option>
            </select>
        </div>

        <!-- Cantidad -->
        <div class="mb-3">
            <label asp-for="OrderDetailsDto.Quantity" class="form-label">Cantidad</label>
            <input asp-for="OrderDetailsDto.Quantity" class="form-control" type="number" min="1"/>
        </div>

        <!-- Botones -->
        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-save w-45">
                <i class="bi bi-check-circle"></i> Guardar
            </button>
            <a asp-page="/Orders/List" class="btn btn-cancel w-45">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </div>
    </form>
</div>
</body>
</html>